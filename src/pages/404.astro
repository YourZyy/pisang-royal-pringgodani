---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Halaman Tidak Ditemukan - Pisang Royal Pringgodani"
  description="Halaman yang kamu buka tidak ditemukan. Kembali ke beranda atau lihat menu Pisang Royal Pringgodani."
>
  <section class="pt-8 pb-20 lg:pt-14 lg:pb-32">
    <div class="wrap">
      <p class="rise font-display font-extrabold text-[clamp(96px,22vw,320px)] leading-[0.85] tracking-[-0.05em] text-ink tabular-nums">
        404
      </p>
      <h1 class="rise mt-6 text-[clamp(32px,5vw,64px)]" style="--d:2">Halaman ini tidak ditemukan.</h1>
      <p class="rise mt-5 text-[18px] text-ink-2 max-w-[44ch]" style="--d:3">
        Tautannya mungkin sudah berubah atau salah ketik. Lihat daftar menu, atau kembali ke beranda.
      </p>
      <div class="rise mt-8 flex flex-col sm:flex-row gap-3" style="--d:4">
        <a href="/menu" class="btn-base btn-primary">Lihat Menu</a>
        <a href="/" class="btn-base btn-secondary">Kembali ke Beranda</a>
      </div>
    </div>
  </section>
</Layout>
