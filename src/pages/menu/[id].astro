---
import Layout from "../../layouts/Layout.astro";
import MenuDetailClient from "../../components/MenuDetailClient";
import MenuCard from "../../components/MenuCard";
import { menuList, formatRupiah } from "../../lib/order";
import { ArrowLeft } from "lucide-react";

export function getStaticPaths() {
  return menuList.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const otherMenus = menuList.filter((m) => m.id !== item.id);
---

<Layout
  title={`${item.nama} (${formatRupiah(item.harga)}) - Pisang Royal Pringgodani`}
  description={`${item.deskripsi} Pesan rasa tunggal atau mix hingga 2 rasa dengan harga tetap Rp20.000, gratis pilihan topping.`}
  ogImage={item.foto}
>
  <section class="pt-6 pb-16 sm:pt-8 lg:pb-24">
    <div class="wrap">
      <a
        href="/menu"
        class="inline-flex items-center gap-1.5 min-h-[44px] text-[15px] font-bold text-ink no-underline link-draw"
      >
        <ArrowLeft className="w-4 h-4" aria-hidden="true" />
        <span>Semua menu</span>
      </a>

      <div class="mt-4 mb-10 lg:mb-14">
        <h1 class="text-[clamp(38px,6vw,80px)]">{item.nama}</h1>
        <p class="mt-4 text-[18px] text-ink-2 max-w-[44ch]">{item.deskripsi}</p>
      </div>

      <MenuDetailClient client:load initialFlavorId={item.id} />
    </div>
  </section>

  <section class="section-y border-t border-ink/20">
    <div class="wrap">
      <h2 class="text-[clamp(30px,4vw,52px)] mb-10" data-reveal>Menu lainnya</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
        {otherMenus.map((other) => (
          <MenuCard client:load item={other} size="xs" />
        ))}
      </div>
    </div>
  </section>
</Layout>
